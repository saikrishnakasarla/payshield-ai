# =============================================================================
# PayShield AI — Production & Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to backend/.env for local development or staging.
# 2. For Cloud Deployment (e.g. Vercel, Railway, Render, AWS), configure these variables
#    in your cloud provider's secure Environment Variables dashboard.
# 3. NEVER commit real production secrets, API keys, or credentials to Git.
# =============================================================================

# =============================================================================
# 1. APPLICATION ENVIRONMENT
# =============================================================================
# Environment tier: "development", "testing", "staging", "production"
APP_NAME="PayShield AI"
APP_ENV="development"

# Set DEBUG=false in production. In production (APP_ENV=production), DEBUG is forced to false.
DEBUG=true

# Operational timeouts
REQUEST_TIMEOUT_SECONDS=30.0
METRICS_ENABLED=true

# =============================================================================
# 2. DATABASE CONFIGURATION
# =============================================================================
# SQLite is permitted ONLY in development and testing.
# For Production / Staging, a persistent managed PostgreSQL database is REQUIRED.
# Supported providers: Neon, Supabase, AWS RDS, GCP Cloud SQL, Render Postgres.
#
# SQLite (Local Dev only):
DATABASE_URL="sqlite:///./payshield.db"
#
# PostgreSQL (Production / Staging):
# DATABASE_URL="postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/payshield_prod?sslmode=require"
#
# Note for Vercel users: POSTGRES_URL is automatically detected if using Vercel Postgres / Neon.
# POSTGRES_URL="postgresql://username:password@host/dbname?sslmode=require"

# Database Seeding:
# Set to false in production to prevent test data from polluting production tables.
SEED_DATABASE=false

# =============================================================================
# 3. AUTHENTICATION & SECURITY
# =============================================================================
# REQUIRED IN PRODUCTION: High-entropy secret key for JWT token signing (minimum 32 characters).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate-a-secure-32-char-random-key-for-production-signing"

# Access token lifespan in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed Frontend Origins for CORS (protocol + domain, no trailing slash)
FRONTEND_ORIGIN="http://localhost:5173"
# CORS_ALLOWED_ORIGINS="https://payshield-ai.vercel.app,https://your-custom-domain.com"

# =============================================================================
# 4. PAYPAL INTEGRATION (SANDBOX & PRODUCTION)
# =============================================================================
# Mode: "sandbox" (testing) or "live" (production)
PAYPAL_MODE="sandbox"
PAYPAL_ENV="sandbox"

# Developer Dashboard: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"

# Base URL:
# Sandbox: https://api-m.sandbox.paypal.com
# Live:    https://api-m.paypal.com
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# PayPal Webhook ID (from Webhook configuration in PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# Mock Simulator Fallback:
# Set to false in staging and production. In production, simulator fallback is strictly rejected.
PAYPAL_MOCK_SIMULATOR=false

# =============================================================================
# 5. GOOGLE GEMINI AI (EXPLAINABLE RISK INTELLIGENCE)
# =============================================================================
# Optional: API key for grounded narrative explanations.
# If omitted or invalid, PayShield AI operates seamlessly using deterministic rule + ML fallback.
# Get API key: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# =============================================================================
# 6. OPTIONAL PAYMENT GATEWAYS (MULTI-GATEWAY TEST MODE)
# =============================================================================
# Stripe (Test Mode): https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Razorpay (Test Mode): https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_rzp_placeholder"

# Adyen (Test Environment): https://ca-test.adyen.com/
ADYEN_API_KEY="adyen_api_key_placeholder"
ADYEN_CLIENT_KEY="adyen_client_key_placeholder"
ADYEN_MERCHANT_ACCOUNT="your_merchant_account_placeholder"
ADYEN_HMAC_KEY="adyen_hmac_placeholder"
ADYEN_ENVIRONMENT="TEST"

# =============================================================================
# 7. RISK DETECTION ENGINE HEURISTIC THRESHOLDS
# =============================================================================
BASELINE_AMOUNT_MULTIPLIER=3.0
VELOCITY_WINDOW_MINUTES=10
VELOCITY_THRESHOLD_COUNT=3
HIGH_FREQUENCY_WINDOW_SECONDS=60
HIGH_FREQUENCY_THRESHOLD_COUNT=4

# Risk Boundaries
MEDIUM_RISK_SCORE=35
HIGH_RISK_SCORE=70
CRITICAL_RISK_SCORE=85
