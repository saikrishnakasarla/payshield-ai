# PayShield AI — Environment Configuration Example
# Copy to backend/.env (or set directly in Vercel Environment Variables).
# NEVER commit .env with real secrets to version control.
# For Vercel: set these in the Vercel Dashboard → Project → Settings → Environment Variables.

# =============================================================================
# Application Core
# =============================================================================
APP_NAME="PayShield AI"
APP_ENV="development"
DEBUG=true

# =============================================================================
# Database
# IMPORTANT: Vercel Serverless uses ephemeral /tmp — transactions will NOT
# persist between cold starts when using SQLite in production.
# For persistent transactions, use a hosted PostgreSQL (e.g. Neon, Supabase).
# PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/dbname"
# =============================================================================
DATABASE_URL="sqlite:///./payshield.db"

# =============================================================================
# Security & Authentication
# REQUIRED IN PRODUCTION: Set a strong, random SECRET_KEY (min 32 chars).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
SECRET_KEY="payshield-hackathon-super-secret-jwt-key-2026-secure-random"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN="http://localhost:5173"

# =============================================================================
# Google Gemini API (Explainable AI Service)
# Leave blank to use the deterministic offline rule explainer.
# =============================================================================
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# =============================================================================
# PayPal Developer Sandbox (Server-side Orders v2)
# Register at: https://developer.paypal.com/dashboard/applications/sandbox
#
# PAYPAL_MODE          : "sandbox" (always use sandbox for testing)
# PAYPAL_CLIENT_ID     : Sandbox app Client ID (from developer.paypal.com)
# PAYPAL_CLIENT_SECRET : Sandbox app Secret (never expose in frontend code)
# PAYPAL_BASE_URL      : Always https://api-m.sandbox.paypal.com for sandbox
# PAYPAL_MOCK_SIMULATOR: false = use real PayPal API (requires credentials)
#                        true  = use built-in offline simulator (no credentials needed)
# PAYPAL_WEBHOOK_ID    : Webhook ID from PayPal Dashboard (optional, for webhook verification)
#
# IMPORTANT: Without valid PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET,
# the system falls back to PAYPAL_MOCK_SIMULATOR=true automatically.
# =============================================================================
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_MOCK_SIMULATOR=false
PAYPAL_WEBHOOK_ID=""

# =============================================================================
# Deterministic Risk Engine Heuristic Weights
# =============================================================================
BASELINE_AMOUNT_MULTIPLIER=3.0
VELOCITY_WINDOW_MINUTES=10
VELOCITY_THRESHOLD_COUNT=3
HIGH_FREQUENCY_WINDOW_SECONDS=60
HIGH_FREQUENCY_THRESHOLD_COUNT=4

# =============================================================================
# Risk Boundaries
# =============================================================================
MEDIUM_RISK_SCORE=35
HIGH_RISK_SCORE=70
